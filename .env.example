BOT_TOKEN=
DATABASE_URL=postgresql://creon:creon@localhost:5432/creon_bot
MODERATOR_IDS=
WEBAPP_URL=
# Необязательно: ID группы поддержки (-100…, узнать — /chatid в группе). В группе включены темы,
# бот — администратор с правом управлять темами. У каждого пользователя своя тема.
SUPPORT_CHAT_ID=
# Необязательно: комиссия площадки для новых заказов, % от бюджета (0–90). Не задана — 20.
PLATFORM_FEE_PERCENT=
# Необязательно: ключ YouTube Data API v3 (Google Cloud → Credentials → API key, тип Public data).
# С ним просмотры роликов YouTube считаются сами; без него их вводит модератор.
YOUTUBE_API_KEY=
# Необязательно: токен VK API для просмотров роликов VK (video.get). Без него просмотры VK вводит модератор.
VK_TOKEN=
