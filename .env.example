BOT_TOKEN=
DATABASE_URL=postgresql://creon:creon@localhost:5432/creon_bot
MODERATOR_IDS=
WEBAPP_URL=
# Необязательно: ID группы поддержки (-100…, узнать — /chatid в группе). В группе включены темы,
# бот — администратор с правом управлять темами. У каждого пользователя своя тема.
SUPPORT_CHAT_ID=
# Необязательно: комиссия площадки для новых заказов, % от бюджета (0–90). Не задана — 20.
PLATFORM_FEE_PERCENT=
# Необязательно: ключ YouTube Data API v3 (Google Cloud → Credentials → API key, тип Public data).
# С ним просмотры роликов YouTube считаются сами; без него их вводит модератор.
YOUTUBE_API_KEY=
# Необязательно: Bearer-токен X API v2 (developer.x.com, оплата за каждый прочитанный пост).
# С ним просмотры видео в постах X считаются сами; без него их вводит модератор.
X_BEARER_TOKEN=
# Необязательно: подключение аккаунтов креаторов (профиль → «Подключить»), по их токенам —
# просмотры роликов TikTok, VK и Instagram. Адрес возврата для настроек приложения на площадке:
# <WEBAPP_URL>/oauth/tiktok/callback, <WEBAPP_URL>/oauth/vk/callback, <WEBAPP_URL>/oauth/instagram/callback.
# TikTok for Developers: Login Kit + Display API (scope video.list) — Client key и Client secret.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# VK ID: ID приложения; право video выдаёт поддержка VK по заявке.
VK_CLIENT_ID=
# Meta for Developers: продукт «Instagram API with Instagram Login» — Instagram App ID и App Secret,
# права instagram_business_basic и instagram_business_manage_insights. Подключаются только
# профессиональные аккаунты (Автор/Бизнес); для всех, кроме тестировщиков, — проверка приложения в Meta.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Ключ шифрования токенов площадок в базе — обязателен, если задана хоть одна площадка выше.
# Сгенерировать: openssl rand -base64 32. Сменить — значит отключить все подключённые аккаунты.
SOCIAL_TOKENS_KEY=
# Необязательно: мониторинг (MONITORING.md). Пусто — выключен, приложение работает как без него.
# Sentry — ошибки бэкенда (5xx, сбои фоновых задач): DSN проекта Node.js.
SENTRY_DSN=
# Grafana Cloud — метрики раз в минуту по OTLP: адрес OTLP-шлюза стека (без /v1/metrics),
# Instance ID и токен с правом metrics:write. Задаются все три или ни одного.
GRAFANA_OTLP_URL=
GRAFANA_OTLP_INSTANCE_ID=
GRAFANA_OTLP_TOKEN=
