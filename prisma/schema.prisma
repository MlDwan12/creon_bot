generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  username   String?
  firstName  String?
  createdAt  DateTime @default(now())
  /// Ссылки креатора на свои соцсети — в профиле (проверка домена: src/api/profile-input.ts).
  tiktokUrl  String?
  youtubeUrl String?
  vkUrl      String?

  orders      Order[]
  submissions Submission[]
  reports     Report[]
}

enum OrderStatus {
  PENDING_MODERATION
  OPEN
  REJECTED
  /// Закрыт рекламодателем вручную.
  CLOSED
  /// Истёк срок (deadline) — закрыт автоматически; рекламодатель может продлить и открыть снова.
  EXPIRED
}

enum OrderCategory {
  PRODUCT_REVIEW
  BEAUTY
  FOOD
  FASHION
  GAMING
  FITNESS
  ENTERTAINMENT
  TECH
  OTHER
}

model Order {
  id               Int           @id @default(autoincrement())
  advertiser       User          @relation(fields: [advertiserId], references: [id])
  advertiserId     Int
  title            String
  description      String
  /// Цена за одно принятое видео в копейках (в API — рубли, см. src/common/money.ts); null — договорная.
  priceKopecks     Int?
  category         OrderCategory @default(OTHER)
  deadline         DateTime?
  status           OrderStatus   @default(PENDING_MODERATION)
  moderatorId      BigInt?
  moderatorComment String?
  createdAt        DateTime      @default(now())
  decidedAt        DateTime?
  closedAt         DateTime?
  /// Креаторам напомнили, что срок истекает меньше чем через сутки. Сбрасывается при продлении.
  deadlineReminderSentAt DateTime?

  submissions Submission[]
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  MODERATOR_APPROVED
  MODERATOR_REJECTED
  ADVERTISER_APPROVED
  ADVERTISER_REJECTED
}

model Submission {
  id                Int              @id @default(autoincrement())
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           Int
  creator           User             @relation(fields: [creatorId], references: [id])
  creatorId         Int
  videoUrl          String?
  status            SubmissionStatus @default(IN_PROGRESS)
  moderatorId       BigInt?
  moderatorComment  String?
  advertiserComment String?
  /// Оценка рекламодателя 1–5 при приёмке видео (ADVERTISER_APPROVED); менять нельзя, модератор может удалить.
  rating            Int?
  review            String?
  /// Рекламодатель разрешил показывать видео в портфолио креатора.
  portfolioAllowed  Boolean          @default(false)
  createdAt         DateTime         @default(now())
  submittedAt       DateTime?
  decidedAt         DateTime?
}

/// На что жалоба. VIDEO и REVIEW — по id отклика (Submission), PROFILE — по id пользователя.
enum ReportTarget {
  ORDER
  VIDEO
  REVIEW
  PROFILE
}

enum ReportStatus {
  OPEN
  /// Модератор принял меры (закрыл заказ, удалил отзыв и т.п.).
  ACTIONED
  DISMISSED
}

/// Жалоба пользователя. targetId без внешнего ключа: объект может быть удалён — жалоба остаётся.
model Report {
  id          Int          @id @default(autoincrement())
  reporter    User         @relation(fields: [reporterId], references: [id])
  reporterId  Int
  target      ReportTarget
  targetId    Int
  /// Код причины — список для каждого target в src/api/reports.service.ts.
  reason      String
  comment     String?
  status      ReportStatus @default(OPEN)
  moderatorId BigInt?
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  /// Одна жалоба от человека на один объект.
  @@unique([reporterId, target, targetId])
  @@index([status])
}
