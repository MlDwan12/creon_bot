generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int       @id @default(autoincrement())
  telegramId         BigInt    @unique
  username           String?
  firstName          String?
  createdAt          DateTime  @default(now())
  /// Ссылки креатора на свои соцсети, по порядку; на одной площадке может быть несколько аккаунтов.
  /// Площадка — по домену ссылки (src/profiles/profile-input.ts, parseLinks).
  socialLinks        String[]  @default([])
  /// Кошелёк USDT (TRC20) для выплат — видят только сам креатор и модераторы (src/payouts/trc20.ts).
  payoutWallet       String?
  /// Когда кошелёк сменили на другой (первый ввод не считается) — модератор видит свежую смену у
  /// заявки на вывод: так выводят деньги с угнанного аккаунта.
  walletChangedAt    DateTime?
  /// Когда креатор впервые открыл «Обучение» — пункт чек-листа «Старт» (packages/shared/src/creator-home.ts).
  lessonSeenAt       DateTime?
  /// Присылать ли сообщение о каждом новом заказе в каталоге — переключатель в профиле.
  notifyNewOrders    Boolean   @default(true)
  /// Язык интерфейса, выбранный в профиле (src/i18n/i18n.ts, LANGS); null — по языку Telegram.
  language           String?
  /// language_code из Telegram — по нему язык, пока человек сам не выбрал; бот пишет на нём же.
  telegramLanguage   String?
  /// Кабинет, открытый в мини-аппе последним (webapp/src/role.ts); null — ещё не выбирал.
  /// Только вкладки и стартовый экран: прав не даёт, быть можно и тем и другим.
  cabinet            Cabinet?
  /// Заблокирован модератором: мини-апп показывает только экран блокировки, бот не пишет.
  bannedAt           DateTime?
  banReason          String?
  /// Бан без права обжалования: мини-апп и сайт — экран «Доступ закрыт» без причины и поддержки,
  /// бот молчит на любые сообщения, ответы поддержки ему не доходят.
  banFinal           Boolean   @default(false)
  /// Тема этого пользователя в группе поддержки (message_thread_id), создаётся при первом обращении.
  supportTopicId     Int?
  /// В какой группе эта тема (SUPPORT_CHAT_ID на момент создания): номер темы уникален только внутри
  /// группы — после смены группы старый номер указал бы на чужую тему.
  supportChatId      String?
  /// Кабинет заказчика открыт модератором (по заявке или сам): без этого заказы не создать и не
  /// править (AdvertiserGuard). Модераторам из MODERATOR_IDS не нужен.
  advertiserAt       DateTime?
  /// Модератор закрыл кабинет: свои заказы видно, новых нет, повторной заявки нет — только через
  /// поддержку (src/advertisers/advertiser-access.ts).
  advertiserClosedAt DateTime?

  orders                 Order[]
  submissions            Submission[]
  orderViews             OrderView[]
  reports                Report[]
  payouts                Payout[]
  socialAccounts         SocialAccount[]
  oauthPendings          OAuthPending[]
  webLogins              WebLogin[]
  advertiserApplications AdvertiserApplication[]
  linkVerifications      LinkVerification[]

  /// Ответ поддержки в теме → чей это пользователь (SupportService.fromSupport).
  @@index([supportChatId, supportTopicId])
}

/// Кабинет мини-аппа: креатора или заказчика (рекламодателя).
enum Cabinet {
  CREATOR
  ADVERTISER
}

enum OrderStatus {
  PENDING_MODERATION
  OPEN
  REJECTED
  /// Закрыт рекламодателем вручную.
  CLOSED
  /// Истёк срок (deadline) — закрыт автоматически; рекламодатель может продлить и открыть снова.
  EXPIRED
  /// Модератор отклонил правку опубликованного заказа: заказ остаётся замороженным (см. editedAt),
  /// рекламодатель исправляет правку или закрывает заказ.
  EDIT_REJECTED
}

/// Валюта денег. Всё в USDT (src/orders/budget.ts); RUB — у старых заказов и выплат.
enum Currency {
  RUB
  USD
  USDT
}

/// Ориентация ролика в требованиях заказа; null в заказе — любая.
enum VideoOrientation {
  VERTICAL
  HORIZONTAL
}

/**
 * Площадки роликов — коды из src/common/platforms.ts (PLATFORMS).
 */
enum VideoPlatform {
  TIKTOK
  YOUTUBE
  VK
  INSTAGRAM
  X
}

enum OrderCategory {
  PRODUCT_REVIEW
  BEAUTY
  FOOD
  FASHION
  GAMING
  FITNESS
  ENTERTAINMENT
  TECH
  OTHER
}

model Order {
  id                     Int               @id @default(autoincrement())
  advertiser             User              @relation(fields: [advertiserId], references: [id])
  advertiserId           Int
  title                  String
  description            String
  /// Ссылка на бриф или материалы — по желанию. Контакты в ней не пропускает order-input.
  referenceUrl           String?
  /// Примеры роликов, какие хочет рекламодатель: 3–10 ссылок на ролики площадок (order-input).
  /// Креатор открывает их через /v/e/<заказ>/<номер> (VideoLinkController) — без ника автора в ссылке.
  exampleUrls            String[]          @default([])
  /// Креатор держит свою ссылку /r/<код> ещё и в шапке профиля — до итога холда. Только с targetUrl.
  linkInBio              Boolean           @default(false)
  /// Страница товара. Креатор ставит в описание ролика не её, а свою ссылку /r/<trackCode> —
  /// так считаем переходы. Мессенджеры и соцсети не пропускает order-input.
  targetUrl              String?
  /// Деньги — в сотых долях валюты (копейки, центы); в API — целые единицы, см. src/common/money.ts.
  currency               Currency          @default(USDT)
  /// Всё, что платит рекламодатель, включая комиссию площадки.
  budgetMinor            Int
  /// Бюджет, который одобрил модератор последним; null — ещё не одобряли. Правка бюджета пишется
  /// в budgetMinor сразу — повышение сверх этого модератор подтверждает отдельно (доплата получена).
  approvedBudgetMinor    Int?
  /// Комиссия площадки в процентах на момент создания: креаторам — budget × (100 − fee) / 100.
  feePercent             Int
  /// Выплата креатору за 1000 просмотров. Ставит модератор при одобрении; до этого null.
  cpmMinor               Int?
  /// Ролик можно сдать, только когда он набрал столько просмотров.
  minViews               Int               @default(250)
  /// Больше этого за один ролик не платим, сколько бы он ни набрал: один вирусный ролик не выбирает
  /// весь фонд. null — без лимита.
  maxPayoutMinor         Int?
  /// Требования к ролику отдельными пунктами: креатор отмечает их при сдаче, модератор отклоняет
  /// с выбором нарушенного. Пусто — только бриф и формат.
  requirements           String[]          @default([])
  /// Токен публичного отчёта по ссылке <WEB_URL>/share/<токен> — без входа, для руководителя
  /// заказчика. null — ссылки нет или отозвана; пересоздание выдаёт новый.
  shareToken             String?           @unique
  category               OrderCategory     @default(OTHER)
  /// Требования к ролику: длительность в секундах и ориентация; null — любая.
  minDurationSec         Int?
  maxDurationSec         Int?
  orientation            VideoOrientation?
  /// Где можно публиковать ролик; пусто — на любой площадке.
  platforms              VideoPlatform[]   @default([])
  deadline               DateTime?
  status                 OrderStatus       @default(PENDING_MODERATION)
  moderatorId            BigInt?
  moderatorComment       String?
  createdAt              DateTime          @default(now())
  /// Когда последний раз отправлен на проверку: при создании и при каждой правке. От него считаются
  /// сдвиг срока при публикации и время модерации (createdAt после правки уже не подходит).
  moderationRequestedAt  DateTime          @default(now())
  decidedAt              DateTime?
  closedAt               DateTime?
  /// Креаторам напомнили, что срок истекает меньше чем через сутки. Сбрасывается при продлении.
  deadlineReminderSentAt DateTime?
  /// Рекламодателю отправлены советы по заказу (src/orders/order-insights.ts) — раз на заказ.
  insightsSentAt         DateTime?
  /// Когда началась последняя правка опубликованного заказа. Пока правку не одобрили (статус
  /// PENDING_MODERATION или EDIT_REJECTED), заказ заморожен: ролики не сдают, слоты не сгорают.
  editedAt               DateTime?
  /// Условия до этой правки — модератору: ролики, сданные раньше editedAt, проверяют по ним.
  prevTerms              Json?
  /// С этого момента весь свободный фонд зарезервирован под ролики на проверке: новые не берут и не
  /// сдают, слоты «в работе» не сгорают. Освободится — слоты продлеваются на это время (syncFundBusy).
  fundBusyAt             DateTime?

  submissions Submission[]
  views       OrderView[]

  /// Каталог (OPEN, новые первыми), очередь модерации (PENDING_MODERATION), сроки — всё по статусу.
  @@index([status, createdAt])
  /// «Мои заказы» и лимит активных заказов.
  @@index([advertiserId])
}

/// Креатор открыл карточку заказа — верх воронки в отчёте рекламодателю. Один раз на пару.
model OrderView {
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())

  @@id([orderId, userId])
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  /// Одобрен модератором: просмотры зафиксированы, деньги начислены. Решение окончательное.
  MODERATOR_APPROVED
  MODERATOR_REJECTED
  /// Креатор не прислал видео за SLOT_DAYS дней после отклика — слот сгорел (ScheduledJob).
  SLOT_EXPIRED
}

model Submission {
  id                 Int              @id @default(autoincrement())
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId            Int
  creator            User             @relation(fields: [creatorId], references: [id])
  creatorId          Int
  videoUrl           String?
  /// Ссылка, приведённая к одному виду (src/common/platforms.ts, videoKey): один ролик — одна оплата.
  videoKey           String?
  /// Код ссылки /r/<код> на страницу товара (Order.targetUrl): переходы считаются по креатору.
  trackCode          String?          @unique
  /// Сколько раз перешли по ссылке креатора — для отчёта рекламодателю, на выплату не влияет.
  clicks             Int              @default(0)
  status             SubmissionStatus @default(IN_PROGRESS)
  moderatorId        BigInt?
  moderatorComment   String?
  /// Просмотры: при сдаче — сколько указал креатор, после одобрения — сколько зафиксировал модератор.
  views              Int?
  /// Лайки — для отчёта рекламодателю, на выплату не влияют. YouTube — из API, иначе вводит
  /// модератор по желанию; null — неизвестно.
  likes              Int?
  /// Деньги креатору за ролик: на проверке — резерв из бюджета, после одобрения — начислено.
  /// Отклонили — 0. Вместе по заказу не больше фонда выплат (src/orders/budget.ts).
  payoutMinor        Int              @default(0)
  /// Просмотры при сдаче вышли за остаток фонда, и креатор согласился на остаток: за ролик закреплено
  /// столько, сверх — не оплачивается. null — ролик влез в фонд.
  agreedPayoutMinor  Int?
  /// Холд закончился: через HOLD_DAYS после одобрения публикация на месте, просмотры для отчёта зафиксированы.
  finalizedAt        DateTime?
  /// Оценка рекламодателя 1–5 одобренному ролику, по желанию; менять нельзя, модератор может удалить.
  rating             Int?
  review             String?
  /// Отзыв с текстом ждёт модератора с этого момента; пока не null — в профиле креатора его нет.
  /// Оценка без текста публикуется сразу (src/submissions/submissions.service.ts, rate).
  reviewQueuedAt     DateTime?
  /// Модератор снял оценку или отзыв — заново оценить ролик нельзя (src/submissions/submissions.service.ts, rate).
  reviewRemovedAt    DateTime?
  /// Рекламодатель разрешил показывать видео в портфолио креатора.
  portfolioAllowed   Boolean          @default(false)
  createdAt          DateTime         @default(now())
  submittedAt        DateTime?
  /// Условия заказа при сдаче (termsOf): по ним проверяют и оплачивают ролик, сколько бы раз заказ
  /// ни правили потом. null — сдан до появления поля (тогда Order.prevTerms, src/orders/order-status.ts).
  terms              Json?
  decidedAt          DateTime?
  /// Креатору напомнили, что слот сгорает меньше чем через сутки.
  slotReminderSentAt DateTime?
  /// Во время холда API площадки не нашло публикацию (удалена или скрыта) с этого момента; null — на
  /// месте или не проверяли. Пока стоит, итог холда сам не фиксируется — решает модератор.
  goneAt             DateTime?
  /// Когда последний раз проверили публикацию по API во время холда (раз в сутки, ScheduledJob).
  presenceCheckedAt  DateTime?
  /// Карточка ролика (виджет Telegram) в чате креатора: её правят при смене статуса. null — не отправлена.
  widgetMessageId    Int?
  viewSnapshots      ViewSnapshot[]

  /// Один отклик «в работе» на креатора и заказ — дубль (двойной тап) отсекает сама база.
  @@unique([orderId, creatorId], map: "Submission_one_in_progress", where: { status: "IN_PROGRESS" })
  /// Один ролик нельзя сдать дважды — ни в тот же заказ, ни в другой, пока он на проверке или одобрен.
  @@unique([videoKey], map: "Submission_video_once", where: raw("status = ANY (ARRAY['SUBMITTED'::\"SubmissionStatus\", 'MODERATOR_APPROVED'::\"SubmissionStatus\"])"))
  /// Отклики по заказу; внешний ключ Postgres сам не индексирует.
  @@index([orderId])
  /// «Мои отклики», профиль креатора, рейтинг.
  @@index([creatorId])
  /// Очередь модерации видео (SUBMITTED, старые первыми) и счётчики по статусам.
  @@index([status, submittedAt])
}

/// На что жалоба. VIDEO и REVIEW — по id отклика (Submission), PROFILE — по id пользователя.
enum ReportTarget {
  ORDER
  VIDEO
  REVIEW
  PROFILE
}

enum ReportStatus {
  OPEN
  /// Модератор принял меры (закрыл заказ, удалил отзыв и т.п.).
  ACTIONED
  DISMISSED
}

/// Жалоба пользователя. targetId без внешнего ключа: объект может быть удалён — жалоба остаётся.
model Report {
  id          Int          @id @default(autoincrement())
  reporter    User         @relation(fields: [reporterId], references: [id])
  reporterId  Int
  target      ReportTarget
  targetId    Int
  /// Код причины — список для каждого target в src/api/reports.service.ts.
  reason      String
  comment     String?
  status      ReportStatus @default(OPEN)
  moderatorId BigInt?
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  /// Одна жалоба от человека на один объект.
  @@unique([reporterId, target, targetId])
  @@index([status])
}

enum PayoutStatus {
  /// Креатор запросил вывод — ждёт менеджера.
  REQUESTED
  /// Менеджер перевёл деньги.
  PAID
  /// Отклонена с причиной — сумма вернулась на баланс.
  REJECTED
}

/// Заявка креатора на вывод начисленного. Сами переводы — вручную, реквизиты — в чате поддержки.
/// Баланс = начислено за одобренные ролики − заявки REQUESTED и PAID (src/api/payouts.service.ts).
model Payout {
  id          Int          @id @default(autoincrement())
  creator     User         @relation(fields: [creatorId], references: [id])
  creatorId   Int
  currency    Currency     @default(USDT)
  amountMinor Int
  /// Кошелёк на момент заявки: смена адреса в профиле не перенаправит уже поданную выплату.
  wallet      String?
  status      PayoutStatus @default(REQUESTED)
  /// Причина отказа — её увидит креатор.
  comment     String?
  moderatorId BigInt?
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  /// Одна открытая заявка на креатора — вторую (двойной тап) не пустит сама база.
  @@unique([creatorId], map: "Payout_one_requested", where: { status: "REQUESTED" })
  /// История выплат креатора.
  @@index([creatorId])
  /// Очередь заявок (REQUESTED, старые первыми).
  @@index([status, createdAt])
}

/// Откуда снимок просмотров ролика.
enum ViewSnapshotSource {
  /// При сдаче: по API площадки, а если не посчитать — со слов креатора.
  SUBMIT
  /// Модератор зафиксировал при одобрении.
  APPROVE
  /// Ежедневная проверка по API во время холда.
  CHECK
  /// Итог холда.
  FINAL
}

/// История просмотров ролика — модератору сигналы накрутки (src/submissions/view-signals.ts).
model ViewSnapshot {
  id           Int                @id @default(autoincrement())
  submission   Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId Int
  views        Int
  likes        Int?
  source       ViewSnapshotSource
  at           DateTime           @default(now())

  @@index([submissionId, at])
}

/// Очередь уведомлений в чат бота (src/telegram/notifications.service.ts). Пишется при событии,
/// отправляет фоновый воркер; отправленное удаляется. Переживает рестарт и падение процесса.
model Notification {
  id           Int      @id @default(autoincrement())
  chatId       BigInt
  text         String
  html         Boolean  @default(false)
  /// Экран мини-аппа для кнопки «Открыть»: путь вроде /my-orders.
  path         String
  /// Обновить карточку ролика (виджет) у креатора. С карточкой вместо text уходит короткий пинг ответом
  /// на неё; text — если виджет не удался или выключен (WIDGETS_ENABLED). Пустой text — только карточка.
  submissionId Int?
  /// Язык получателя (src/i18n): на нём подпись кнопки «Открыть». Текст уже переведён при постановке.
  lang         String   @default("ru")
  /// 0 — обычные, 1 — рассылки: обычные уходят первыми, рассылка не задерживает срочное.
  priority     Int      @default(0)
  attempts     Int      @default(0)
  /// Не раньше этого момента: пауза после 429 или сбоя, а взятое воркером — «аренда» на время отправки.
  sendAfter    DateTime @default(now())
  createdAt    DateTime @default(now())

  /// Выборка воркера: готовые к отправке, по приоритету.
  @@index([priority, sendAfter])
}

/**
 * Площадки, где креатор подключает свой аккаунт (OAuth): по его токену берём просмотры его роликов.
 */
enum SocialPlatform {
  TIKTOK
  VK
  INSTAGRAM
}

/**
 * Аккаунт креатора на площадке, подключённый через OAuth (src/accounts). Токены — зашифрованы
 * (SOCIAL_TOKENS_KEY, src/accounts/token-crypto.ts): это доступ к чужому аккаунту.
 * Рекламодателю аккаунт не показываем — контакты сторон скрыты.
 */
model SocialAccount {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        SocialPlatform
  /// id пользователя на площадке: TikTok open_id, VK user_id, Instagram user_id.
  externalId      String
  /// Имя аккаунта на площадке — креатору, чтобы различать свои аккаунты; null — площадка не отдала.
  label           String?
  accessToken     String
  refreshToken    String
  accessExpiresAt DateTime
  /// VK ID: без device_id токен не обновить.
  deviceId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  /// Один аккаунт площадки — одному креатору: чужой аккаунт к себе не подключить.
  @@unique([platform, externalId])
  /// У креатора может быть несколько аккаунтов одной площадки (AccountsService, MAX_PER_PLATFORM).
  @@index([userId, platform])
}

/**
 * Начатое подключение аккаунта площадки (AccountsService.start): ждём, когда креатор вернётся с
 * площадки. В базе, а не в памяти: callback может прийти в другую копию бота или после рестарта.
 */
model OAuthPending {
  /// Одноразовый state из ссылки входа.
  state     String         @id
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  SocialPlatform
  /// PKCE: секрет, чей хеш ушёл в ссылку входа.
  verifier  String
  expiresAt DateTime
  /// Вход на площадке прошёл, ждём подтверждения на странице возврата (AccountsService.confirm):
  /// аккаунт (токены — зашифрованы) и state — новый одноразовый код, а не тот, что был в ссылке входа.
  /// null — вход ещё не прошёл.
  account   Json?

  @@index([expiresAt])
}

/**
 * Какая копия бота выполняет фоновые задачи (src/jobs/job-lease.ts). Аренду продлевает каждый
 * проход держателя; копия упала — по истечении аренды задачи забирает другая. Иначе при двух
 * копиях напоминания и итоги задвоились бы.
 */
model JobLease {
  name   String   @id
  /// Случайный id процесса-держателя.
  holder String
  until  DateTime
}

/// Что сделал модератор — тип строки журнала ModeratorAction.
enum ModeratorActionType {
  ORDER_APPROVE
  ORDER_REJECT
  VIDEO_APPROVE
  VIDEO_REJECT
  /// Итог холда зафиксирован: публикация на месте.
  HOLD_FINALIZE
  /// При итоге холда публикации нет — начисление отменено.
  PUBLICATION_DELETED
  REVIEW_APPROVE
  REVIEW_REMOVE
  /// Жалобы на объект: мера применена.
  REPORT_ACTION
  /// Жалобы на объект: нарушений нет.
  REPORT_DISMISS
  PAYOUT_PAID
  PAYOUT_REJECT
  USER_BAN
  USER_UNBAN
  /// Кабинет заказчика открыт (заявка одобрена или модератор сам). objectId — пользователь.
  ADVERTISER_OPEN
  /// Заявка в заказчики отклонена. objectId — пользователь.
  ADVERTISER_REJECT
  /// Кабинет заказчика закрыт. objectId — пользователь.
  ADVERTISER_CLOSE
  /// Аккаунт соцсети подтверждён кодом. objectId — пользователь, comment — ссылка.
  LINK_VERIFY
  /// Кода в описании аккаунта нет. objectId — пользователь, comment — ссылка.
  LINK_NO_CODE
}

/// Журнал решений модераторов — кабинет модератора, таблица команды и выгрузка CSV
/// (src/moderation/moderator-actions.service.ts). Строки только добавляются: повторная модерация
/// не затирает прежнюю, как moderatorId в самих заказах и роликах.
model ModeratorAction {
  id           Int                 @id @default(autoincrement())
  /// Telegram ID модератора (MODERATOR_IDS) — как moderatorId в Order/Submission/Payout.
  moderatorId  BigInt
  type         ModeratorActionType
  /// id заказа, отклика (ролик, холд, отзыв), заявки на вывод, пользователя; у жалоб — id объекта жалобы.
  objectId     Int
  /// У жалоб — на что они: ссылку на объект в кабинете строим по нему.
  reportTarget ReportTarget?
  /// Деньги решения, центы USDT: выплата, начисление за ролик, бюджет заказа.
  amountMinor  Int?
  /// Сколько объект ждал решения, секунды; null — неизвестно (бан, отзыв).
  waitedSec    Int?
  /// Причина: блокировки, отказа (заказ, ролик, выплата) — для истории пользователя.
  comment      String?
  createdAt    DateTime            @default(now())

  /// Кабинет модератора: его действия за период, новые первыми.
  @@index([moderatorId, createdAt])
  /// Таблица команды и выгрузка: все действия за период.
  @@index([createdAt])
}

/// Вход на сайт кодом из бота, без окна Telegram с номером телефона (src/auth/web-login.service.ts):
/// сайт получает ссылку t.me/<бот>?start=login_<токен>, бот присылает тому, кто её открыл, код из
/// 4 цифр, его вводят на сайте. Храним только хеши: по базе войти нельзя.
model WebLogin {
  /// sha256 токена из ссылки — токен знает только страница, начавшая вход.
  tokenHash String   @id
  /// Кто открыл ссылку в Telegram; null — ещё никто, кода нет.
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 кода вместе с токеном.
  codeHash  String?
  /// Неверных кодов: после 5 вход по этой ссылке закрыт.
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum AdvertiserApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Заявка креатора «Стать заказчиком»: команда созванивается и открывает кабинет или отказывает
/// (src/advertisers). Контакты видят только модераторы. После отказа — новая через ADVERTISER_RETRY_DAYS.
enum LinkVerificationStatus {
  /// Креатор добавил код в описание — ждёт модератора.
  PENDING
  VERIFIED
  /// Модератор кода не нашёл — можно отправить снова.
  NO_CODE
}

/// Подтверждение, что аккаунт соцсети из профиля (User.socialLinks) — креатора: код в описании
/// аккаунта, сверяет модератор (src/profiles/link-verifications.service.ts). Ссылку убрали из профиля —
/// её подтверждение не действует. Действует последняя запись по ссылке.
model LinkVerification {
  id          Int                    @id @default(autoincrement())
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  url         String
  code        String
  status      LinkVerificationStatus @default(PENDING)
  /// Telegram ID модератора, который решил.
  moderatorId BigInt?
  decidedAt   DateTime?
  createdAt   DateTime               @default(now())

  /// Одна проверка на ссылку за раз — двойной тап не создаст вторую.
  @@unique([userId, url], map: "LinkVerification_one_pending", where: { status: "PENDING" })
  @@index([userId])
  /// Очередь модератора.
  @@index([status])
}

model AdvertiserApplication {
  id             Int                         @id @default(autoincrement())
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  email          String
  /// По желанию: с номером команда свяжется быстрее.
  phone          String?
  /// Согласие на обработку данных: редакция политики (PRIVACY_VERSION), на которую согласились, дата — createdAt.
  /// null — заявка подана до галочки согласия.
  consentVersion String?
  status         AdvertiserApplicationStatus @default(PENDING)
  /// Telegram ID модератора, который решил заявку.
  moderatorId    BigInt?
  /// Заметка модератора при отказе — пользователю не показываем.
  note           String?
  decidedAt      DateTime?
  createdAt      DateTime                    @default(now())

  /// Одна заявка на рассмотрении на человека — двойной тап не создаст вторую.
  @@unique([userId], map: "AdvertiserApplication_one_pending", where: { status: "PENDING" })
  /// Последняя заявка пользователя — по ней состояние кнопки.
  @@index([userId, id])
  /// Очередь модератора.
  @@index([status])
}
